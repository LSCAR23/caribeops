# Local development only; change this password for any shared or deployed environment.
POSTGRES_DB=caribeops
POSTGRES_USER=caribeops
POSTGRES_PASSWORD=caribeops_local

# Host port used by local database tools such as DBeaver.
POSTGRES_PORT=5433

# Password for the dedicated Go-analytics login role (created by
# docker/postgres-init/01-analytics-role.sh; D5-08). Local development only.
ANALYTICS_DB_PASSWORD=
