# Analytics service configuration
APP_ENV=development
PORT=8080

# PostgreSQL connection used by analytics and data queries
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=caribeops
POSTGRES_USER=caribeops
POSTGRES_PASSWORD=caribeops_local
DATABASE_URL=postgres://caribeops:caribeops_local@postgres:5432/caribeops?sslmode=disable
